CREATE TABLE productos (
  id INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(100),
  precio DECIMAL(10, 2),
  categoriaId INT,
  FOREIGN KEY (categoriaId) REFERENCES categorias(id) ON DELETE CASCADE
);